{
  "name": "pubky-drive",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "audit": "npm audit --audit-level=moderate",
    "check": "npm run format:check && npm run lint",
    "format": "prettier \"**/*.{js,ts,tsx,json,yml,yaml,md,html,css}\" --write",
    "format:check": "prettier \"**/*.{js,ts,tsx,json,yml,yaml,md,html,css}\" --check",
    "lint": "npm run lint:code && npm run lint:actions",
    "lint:actions": "github-actionlint .github/workflows/*.yml",
    "lint:code": "eslint ."
  },
  "dependencies": {
    "@synonymdev/pubky": "^0.16.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.61.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "github-actionlint": "^1.7.12",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "github-actionlint": {
      "adm-zip": "0.6.1"
    }
  }
}
